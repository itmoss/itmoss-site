---
// 우주데브리스 처리 순서 — 단계마다 그림(매니페스트 슬롯 uzu-flow-*, gpt-image-2) + 제목·설명은 DOM.
// CaseUzudebris 의 3단계 목록 아래에 놓인다. 넓은 화면은 가로 네 칸, 좁은 화면(≤760px)은 두 칸씩 쌓는다.
// 문구: docs/renewal/copy.md "## 우주데브리스" — 목록 이름(label)은 그곳 문장 그대로.
import RenewalImage from './RenewalImage.astro';

const label = '원본 등록, 컨텐츠 예측과 후보 검색, 지문 대조, 본인 알림으로 이어지는 우주데브리스 처리 순서';

const nodes = [
  { slot: 'uzu-flow-register', title: '원본 등록', sub: '채널 주소 · 원본 파일' },
  { slot: 'uzu-flow-predict', title: '컨텐츠 예측', sub: '자막 · 장면으로 후보 검색' },
  { slot: 'uzu-flow-match', title: '지문 대조', sub: '찾은 후보만 화면 · 소리로' },
  { slot: 'uzu-flow-notify', title: '본인 알림', sub: '위치 · 신고 방법 안내' },
];
const last = nodes.length - 1;
// 순서 번호는 위 3단계 목록(01–03)에만 둔다 — 그림까지 번호를 매기면 01–04 와 겹쳐 읽힌다. 순서는 화살표로 보인다.
---
<figure class="uzu-flow" data-reveal>
  <figcaption class="visually-hidden">{label}</figcaption>
  <ol class="uzu-flow__list">
    {nodes.map((n, i) => (
      <li class:list={['uzu-flow__node', { 'uzu-flow__node--end': i === last }]}>
        <RenewalImage slot={n.slot} ratio="1 / 1" class="uzu-flow__img" />
        <div class="uzu-flow__text">
          <p class="uzu-flow__title">{n.title}</p>
          <p class="uzu-flow__sub">{n.sub}</p>
        </div>
      </li>
    ))}
  </ol>
</figure>

<style>
  .uzu-flow {
    margin: 0;
    color: var(--color-ink);
  }
  .uzu-flow__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-10);
  }
  .uzu-flow__node {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line-on-paper);
  }
  .uzu-flow__node--end {
    border: 2px solid var(--color-signal-ink);
  }
  /* 칸 사이 화살표 — 다음 칸으로 */
  .uzu-flow__node:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: calc(var(--space-10) / -2 - 6px);
    width: 10px;
    height: 10px;
    border-top: 1.5px solid var(--color-muted-on-paper);
    border-right: 1.5px solid var(--color-muted-on-paper);
    transform: translateY(-50%) rotate(45deg);
  }
  .uzu-flow__node :global(.uzu-flow__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    border-bottom: 1px solid var(--color-line-on-paper);
  }
  .uzu-flow__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
  }
  .uzu-flow__title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: var(--leading-tight);
    word-break: keep-all;
  }
  .uzu-flow__sub {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-muted-on-paper);
    word-break: keep-all;
  }

  @media (max-width: 760px) {
    .uzu-flow__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
    /* 두 칸씩 쌓이면 화살표 방향이 줄마다 꺾여 오히려 헷갈린다 — 순서는 읽는 순서로 */
    .uzu-flow__node:not(:last-child)::after {
      display: none;
    }
    .uzu-flow__text {
      padding: var(--space-4);
    }
  }
</style>
