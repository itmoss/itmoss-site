---
// #haepick CASE 02. 문구: docs/renewal/copy.md "## 해픽".
// 숫자는 출처 있는 사실만 (design.md 문구 원칙). 다운로드·사용자 수·정확도 같은 수치는 넣지 않는다.
// 단계: 네 단계를 카드로 나란히 두고 카드마다 그림(매니페스트 슬롯 hp-step-*, gpt-image-2 — 해픽 점토풍 톤)을 붙인다.
// 예전 sticky 장면(왼쪽 고정 이미지 + 오른쪽 단계 점등)은 단계 사이가 멀고 그림과 따로 놀아 걷어냈다.
// 앱 아이콘은 App Store 공개 자료를 자체 호스팅한 것 (scripts/fetch-haepick.mjs, 출처 public/images/haepick/sources.json).
// 촬영 장면(capture.webp)은 haepick.ai/ko '촬영해!픽' 의 움직이는 webp 를 자체 호스팅한 것 — 핫링크 금지.
// 동작 줄이기 설정이면 첫 프레임(capture-still.webp)으로 바꾼다.
import RenewalImage from './RenewalImage.astro';

const stages = [
  { key: 'capture', slot: 'hp-step-camera', label: '찍기', body: '궁금한 화장품을 카메라로 찍습니다.' },
  { key: 'detect', slot: 'hp-step-detect', label: '제품 인식', body: '찍은 사진 속 제품이 무엇인지 알아봅니다.' },
  { key: 'analyze', slot: 'hp-step-ingredients', label: '성분·제품 정보 분석', body: '표기된 성분과 제품 정보를 읽어 정리합니다.' },
  { key: 'match', slot: 'hp-step-match', label: '내 피부 적합도', body: '내 피부 기준으로 맞는지, 주의할 성분은 없는지 확인합니다.' },
];

const facts = [
  { label: '출시', value: '2025.08' },
  { label: '업데이트', value: '11회 · v1.0.10' },
  { label: '실행 환경', value: '온디바이스 경량 모델' },
  { label: '현장 검증', value: '성수 팝업 7일 (2025.12.17–23)' },
];

// 스토어 URL 은 짧은 형식 — 한글 슬러그를 퍼센트 인코딩한 긴 URL 은 쓰지 않는다.
const stores = [
  { href: 'https://apps.apple.com/kr/app/id6748489765', label: 'App Store 에서 해픽 보기' },
  { href: 'https://play.google.com/store/apps/details?id=com.woodang.haepick_client&hl=ko', label: 'Google Play 에서 해픽 보기' },
];
---
<section id="haepick" class="section section--light" aria-labelledby="haepick-title">
  <div class="container section__inner">
    <div class="hp-top">
      <header class="section__head">
        <img class="hp-icon" src="/images/haepick/icon.webp" width="512" height="512" alt="해픽 앱 아이콘" loading="lazy" decoding="async" />
        <p class="eyebrow eyebrow--on-paper">CASE 02 · 해픽 — VISION AI</p>
        <h2 id="haepick-title" class="section__title">찍으면 바로,<br />내 피부에 맞는지.</h2>
        <p class="section__lead">
          아이티모스의 JVL 비전 엔진이 상용 앱 「해픽」과 함께하고 있습니다. 궁금한 화장품을 찍으면 제품을 인식하고, 성분과 제품 정보를 분석해 내 피부에 맞는지 알려 줍니다.
        </p>
      </header>

      <figure class="hp-capture">
        <picture>
          <source media="(prefers-reduced-motion: reduce)" srcset="/images/haepick/capture-still.webp" type="image/webp" />
          <img
            class="hp-capture__img"
            src="/images/haepick/capture.webp"
            width="528"
            height="465"
            alt="스캔 틀 안에 세운 세럼병을 스마트폰으로 찍는 해픽 촬영 장면"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="hp-capture__caption">
          <q>이 화장품, 나한테 맞을까?</q>
          <span class="hp-capture__source">— 해픽 「촬영해!픽」</span>
        </figcaption>
      </figure>
    </div>

    <ol class="hp-steps" data-step-group>
      {stages.map((s, i) => (
        <li class="hp-steps__item" data-step={i + 1} data-stage={s.key}>
          <RenewalImage slot={s.slot} ratio="1 / 1" class="hp-steps__img" />
          <div class="hp-steps__text">
            <span class="hp-steps__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="hp-steps__title">{s.label}</h3>
            <p class="hp-steps__body">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <dl class="hp-facts">
      {facts.map((f) => (
        <div class="hp-facts__item">
          <dt class="hp-facts__label">{f.label}</dt>
          <dd class="hp-facts__value">{f.value}</dd>
        </div>
      ))}
    </dl>

    <div class="hp-actions">
      <ul class="hp-stores">
        {stores.map((s) => (
          <li>
            <a class="btn btn--ghost hp-stores__btn" href={s.href} rel="noopener">
              {s.label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="hp-b2b">
        화장품 브랜드와 매장에 맞춘 인식 기능은 협업으로 만듭니다.
        <a class="hp-b2b__link" href="#contact">협업 문의 <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </div>
</section>

<style>
  .hp-icon {
    width: 64px;
    height: 64px;
    border-radius: 22%;
    border: 1px solid var(--color-line-on-paper);
  }

  .hp-top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }
  .hp-capture {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .hp-capture__img {
    display: block;
    width: 100%;
    max-width: 528px;
    height: auto;
  }
  .hp-capture__caption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    word-break: keep-all;
  }
  .hp-capture__source {
    color: var(--color-muted-on-paper);
  }
  @media (max-width: 960px) {
    .hp-top {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .hp-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .hp-steps__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .hp-steps__item :global(.hp-steps__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--color-line-on-paper);
  }
  .hp-steps__num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-signal-ink);
  }
  .hp-steps__title {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    word-break: keep-all;
  }
  .hp-steps__body {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-muted-on-paper);
    word-break: keep-all;
  }
  .hp-steps__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  @media (max-width: 960px) {
    .hp-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-10);
    }
  }
  @media (max-width: 480px) {
    .hp-steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .hp-facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    border-top: 1px solid var(--color-line-on-paper);
    border-bottom: 1px solid var(--color-line-on-paper);
  }
  .hp-facts__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-6) var(--space-6) 0;
  }
  .hp-facts__label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted-on-paper);
  }
  .hp-facts__value {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: var(--leading-tight);
    word-break: keep-all;
  }

  .hp-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .hp-stores {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hp-stores__btn {
    gap: var(--space-2);
  }
  .hp-b2b {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-muted-on-paper);
    word-break: keep-all;
  }
  .hp-b2b__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-left: var(--space-2);
    color: var(--color-signal-ink);
    text-underline-offset: 4px;
  }
</style>
