---
// #haepick CASE 02 — data-scene="haepick". 문구: docs/renewal/copy.md "## 해픽".
// 숫자는 출처 있는 사실만 (design.md 문구 원칙). 다운로드·사용자 수·정확도 같은 수치는 넣지 않는다.
// 장면: 넓은 화면에서 해픽 앱 화면이 sticky 로 고정되고, 오른쪽 단계(data-stage)가 하나씩 지나간다.
// 이미지는 App Store 공개 자료를 자체 호스팅한 것 (scripts/fetch-haepick.mjs, 출처 public/images/haepick/sources.json).
// 고정 이미지는 해픽 소개 페이지(haepick.ai/ko)의 '촬영해!픽' 장면 — 제품을 비추면 인식 틀이 잡히고 스캔선이 지나간다.
// 움직이는 webp, 움직임 줄이기 설정이면 정지 png.

const stages = [
  { stage: 'camera', label: '비추기', body: '카메라에 제품을 비춥니다.' },
  { stage: 'detect', label: '제품 인식', body: '화면 속 제품을 찾아 표시합니다.' },
  { stage: 'ingredients', label: '성분 읽기', body: '표기된 성분을 읽어 옵니다.' },
  { stage: 'match', label: '피부 맞춤', body: '내 피부 기준으로 맞는 성분과 주의할 성분을 나눠 봅니다.' },
];

const facts = [
  { label: '출시', value: '2025.08' },
  { label: '업데이트', value: '11회 · v1.0.10' },
  { label: '실행 환경', value: '온디바이스 경량 모델' },
  { label: '현장 검증', value: '성수 팝업 7일 (2025.12.17–23)' },
];

// 스토어 URL 은 짧은 형식 — 한글 슬러그를 퍼센트 인코딩한 긴 URL 은 쓰지 않는다.
const stores = [
  { href: 'https://apps.apple.com/kr/app/id6748489765', label: 'App Store 에서 해픽 보기' },
  { href: 'https://play.google.com/store/apps/details?id=com.woodang.haepick_client&hl=ko', label: 'Google Play 에서 해픽 보기' },
];
---
<section id="haepick" class="section section--light" data-scene="haepick" aria-labelledby="haepick-title">
  <div class="container section__inner">
    <header class="section__head">
      <img class="hp-icon" src="/images/haepick/icon.webp" width="512" height="512" alt="해픽 앱 아이콘" loading="lazy" decoding="async" />
      <p class="eyebrow eyebrow--on-paper">CASE 02 · 해픽 — VISION AI</p>
      <h2 id="haepick-title" class="section__title">스캔 한 번에,<br />나만의 성분 확인.</h2>
      <p class="section__lead">
        아이티모스의 JVL 비전 엔진이 상용 앱 「해픽」과 함께하고 있습니다. 제품을 스캔하면 바로 인식하고, 성분을 읽어 내 피부 기준으로 분석해 줍니다.
      </p>
    </header>

    <div class="hp-scene">
      <figure class="hp-phone">
        <picture>
          <source srcset="/images/haepick/scan.png" media="(prefers-reduced-motion: reduce)" />
          <img
            class="hp-phone__img"
            src="/images/haepick/scan.webp"
            width="528"
            height="465"
            alt="해픽으로 화장품을 촬영하는 장면 — 스마트폰 카메라가 화장품 병을 인식 틀 안에 잡고 스캔선이 지나간다"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="hp-phone__cap">촬영해!픽 — 이 화장품, 나한테 맞을까? · haepick.ai</figcaption>
      </figure>
      <ol class="hp-stages">
        {stages.map((s, i) => (
          <li class="hp-stages__item" data-stage={s.stage}>
            <span class="hp-stages__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="hp-stages__title">{s.label}</h3>
            <p class="hp-stages__body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>

    <dl class="hp-facts">
      {facts.map((f) => (
        <div class="hp-facts__item">
          <dt class="hp-facts__label">{f.label}</dt>
          <dd class="hp-facts__value">{f.value}</dd>
        </div>
      ))}
    </dl>

    <div class="hp-actions">
      <ul class="hp-stores">
        {stores.map((s) => (
          <li>
            <a class="btn btn--ghost hp-stores__btn" href={s.href} rel="noopener">
              {s.label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="hp-b2b">
        화장품 브랜드와 매장에 맞춘 인식 기능은 협업으로 만듭니다.
        <a class="hp-b2b__link" href="#contact">협업 문의 <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </div>
</section>

<style>
  .hp-scene {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-12);
    align-items: start;
  }
  .hp-phone {
    position: sticky;
    top: calc(var(--header-h) + var(--space-8));
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: min(100%, 480px);
  }
  .hp-phone__img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hp-phone__cap {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted-on-paper);
  }
  .hp-icon {
    width: 64px;
    height: 64px;
    border-radius: 22%;
    border: 1px solid var(--color-line-on-paper);
  }

  @media (max-width: 760px) {
    .hp-scene {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
    /* 좁은 화면은 한 줄로 쌓이므로 고정하지 않는다 */
    .hp-phone {
      position: relative;
      top: auto;
      width: min(100%, 360px);
    }
  }

  .hp-stages {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-line-on-paper);
  }
  .hp-stages__item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3);
    /* 단계마다 스크롤 거리를 줘서 고정된 폰 옆을 하나씩 지나가게 */
    min-height: 50svh;
    padding: var(--space-8) var(--space-6) var(--space-8) 0;
    border-bottom: 1px solid var(--color-line-on-paper);
  }
  @media (max-width: 760px) {
    .hp-stages__item {
      min-height: 0;
    }
  }
  .hp-stages__num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-signal-ink);
  }
  .hp-stages__title {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    word-break: keep-all;
  }
  .hp-stages__body {
    margin: 0;
    max-width: 32ch;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-muted-on-paper);
    word-break: keep-all;
  }

  .hp-facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    border-top: 1px solid var(--color-line-on-paper);
    border-bottom: 1px solid var(--color-line-on-paper);
  }
  .hp-facts__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-6) var(--space-6) 0;
  }
  .hp-facts__label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted-on-paper);
  }
  .hp-facts__value {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: var(--leading-tight);
    word-break: keep-all;
  }

  .hp-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .hp-stores {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hp-stores__btn {
    gap: var(--space-2);
  }
  .hp-b2b {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-muted-on-paper);
    word-break: keep-all;
  }
  .hp-b2b__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-left: var(--space-2);
    color: var(--color-signal-ink);
    text-underline-offset: 4px;
  }
</style>
