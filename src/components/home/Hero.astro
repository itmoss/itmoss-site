---
// #top 히어로. 문구: docs/renewal/copy.md "## 히어로". 공모전 소식은 넣지 않는다 (#record 에만).
// 히어로 이미지는 매니페스트 슬롯 hero (16:7). 첫 화면이라 fetchpriority=high.
import RenewalImage from './RenewalImage.astro';
---
<section id="top" class="hero">
  <div class="container hero__inner">
    <h1 class="hero__title">영상 해킹에 맞서는<br />단 하나의 솔루션, 우주데브리스</h1>
    <p class="hero__lead">
      아이티모스는 영상과 보안을 20년 다뤄 온 팀이 만든 비전 AI 회사입니다. 화면 속 사물을 읽는 엔진과, 같은 영상을 찾아내는 비전 AI 엔진을 만듭니다.
    </p>
    <div class="hero__actions">
      <a class="btn btn--signal" href="#uzudebris">우주데브리스 보기</a>
    </div>

    <RenewalImage slot="hero" ratio="16 / 7" priority class="hero__image" />
  </div>
</section>

<style>
  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    padding-block: var(--space-30) var(--space-24);
  }
  .hero__title {
    margin: 0;
    font-size: clamp(40px, 7vw, 96px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.03em;
    word-break: keep-all;
  }
  .hero__lead {
    margin: 0;
    max-width: 620px;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    font-weight: 300;
    color: var(--color-muted);
    word-break: keep-all;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* 여러 화면에 흩어진 같은 장면 — 하나만 시그널 윤곽선 */
  .hero__inner :global(.hero__image) {
    margin-top: var(--space-10);
  }

  @media (max-width: 640px) {
    .hero__inner {
      padding-block: var(--space-20) var(--space-16);
      gap: var(--space-8);
    }
    .hero__inner :global(.hero__image) {
      margin-top: var(--space-4);
    }
  }
</style>
