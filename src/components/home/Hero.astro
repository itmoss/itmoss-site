---
// #top 히어로. 문구: docs/renewal/copy.md "## 히어로". 모두의 창업 소식은 넣지 않는다.
// 히어로 이미지(F16)가 생기기 전에는 같은 비율(16:7)의 장면 프레임으로 자리를 잡는다 (CLS 방지).
const screens = Array.from({ length: 6 }, (_, i) => i);
const marked = 3;
---
<section id="top" class="hero">
  <div class="container hero__inner">
    <h1 class="hero__title">영상을 만드는 기술로,<br />영상을 지킵니다.</h1>
    <p class="hero__lead">
      아이티모스는 스트리밍과 트랜스코딩을 20년 다뤄 온 팀이 만든 비전 AI 회사입니다. 화면 속 사물을 읽는 엔진과, 같은 영상을 찾아내는 엔진을 만듭니다.
    </p>
    <div class="hero__actions">
      <a class="btn btn--signal" href="#uzudebris">우주데브리스 보기</a>
      <a class="btn btn--ghost" href="#contact">협업 문의</a>
    </div>

    <div class="hero__frame" aria-hidden="true">
      {screens.map((i) => (
        <span class:list={['hero__screen', { 'hero__screen--marked': i === marked }]}>
          <span class="hero__scene"></span>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    padding-block: var(--space-30) var(--space-24);
  }
  .hero__title {
    margin: 0;
    font-size: clamp(40px, 7vw, 96px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.03em;
    word-break: keep-all;
  }
  .hero__lead {
    margin: 0;
    max-width: 620px;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    font-weight: 300;
    color: var(--color-muted);
    word-break: keep-all;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* 여러 화면에 흩어진 같은 장면 — 하나만 시그널 윤곽선 */
  .hero__frame {
    margin-top: var(--space-10);
    aspect-ratio: 16 / 7;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-line);
  }
  .hero__screen {
    position: relative;
    border: 1px solid var(--color-line);
    overflow: hidden;
  }
  .hero__scene {
    position: absolute;
    inset: 22% 18% 22% 30%;
    border: 1px solid var(--color-line);
  }
  .hero__scene::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 30%;
    background: var(--color-line);
  }
  .hero__screen:nth-child(2n) .hero__scene { inset: 18% 30% 26% 16%; }
  .hero__screen:nth-child(3n) .hero__scene { inset: 26% 22% 18% 24%; }
  .hero__screen--marked {
    outline: 2px solid var(--color-signal);
    outline-offset: -1px;
  }
  .hero__screen--marked .hero__scene {
    border-color: var(--color-signal);
  }

  @media (max-width: 640px) {
    .hero__inner {
      padding-block: var(--space-20) var(--space-16);
      gap: var(--space-8);
    }
    .hero__frame {
      aspect-ratio: 4 / 3;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(3, minmax(0, 1fr));
      margin-top: var(--space-4);
    }
  }
</style>
