---
// #top 히어로. 문구: docs/renewal/copy.md "## 히어로". 공모전 소식은 넣지 않는다 (#record 에만).
// 비주얼은 3D 지구본(HeroGlobe) — 데스크톱은 제목 옆, 좁은 화면은 제목 아래.
import HeroGlobe from './HeroGlobe.astro';
---
<section id="top" class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <h1 class="hero__title">영상 해킹에 맞서는<br />단 하나의 솔루션, <span class="hero__rainbow">우주데브리스</span></h1>
      <p class="hero__lead">
        아이티모스는 영상과 보안을 20년간 다뤄 온 팀이 만든 영상 해킹 AI 회사입니다. 화면 속 사물을 분석하는 비전 엔진과, 해킹된 영상을 찾아내는 보안 AI 엔진을 만듭니다.
      </p>
      <div class="hero__actions">
        <a class="btn btn--signal" href="#uzudebris">우주데브리스 보기</a>
      </div>
    </div>

    <div class="hero__visual">
      <HeroGlobe />
    </div>
  </div>
</section>

<style>
  .hero__inner {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-30) var(--space-24);
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    min-width: 0;
  }
  .hero__title {
    margin: 0;
    font-size: clamp(40px, 7vw, 96px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.03em;
    word-break: keep-all;
  }
  /* "우주데브리스" 만 무지개 빛이 천천히 훑고 지나간다 (background-position 만 움직임) */
  .hero__rainbow {
    background: linear-gradient(
        100deg,
        var(--rainbow-1),
        var(--rainbow-2),
        var(--rainbow-3),
        var(--rainbow-4),
        var(--rainbow-5),
        var(--rainbow-6),
        var(--rainbow-1)
      )
      0 50% / 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: hero-rainbow 6s linear infinite;
  }
  @keyframes hero-rainbow {
    to {
      background-position: -200% 50%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__rainbow {
      animation: none;
    }
  }
  .hero__lead {
    margin: 0;
    max-width: 620px;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    font-weight: 300;
    color: var(--color-muted);
    word-break: keep-all;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hero__visual {
    min-width: 0;
  }

  /* 넓은 화면: 제목 옆에 지구본. 제목 글자가 지구본 위로 조금 겹쳐도 되게 지구본을 뒤에 둔다 */
  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
    }
    .hero__title {
      font-size: clamp(40px, 5.6vw, 88px);
    }
    .hero__text {
      position: relative;
      z-index: 1;
    }
    .hero__visual {
      margin-inline-start: calc(var(--space-16) * -1);
    }
  }

  @media (max-width: 640px) {
    .hero__inner {
      padding-block: var(--space-20) var(--space-16);
      gap: var(--space-8);
    }
    .hero__text {
      gap: var(--space-8);
    }
    .hero__visual {
      max-width: 360px;
      width: 100%;
      margin-inline: auto;
    }
  }
</style>
