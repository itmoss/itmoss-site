---
// #uzudebris CASE 01 — 밝은 배경 섹션. 문구: docs/renewal/copy.md "## 우주데브리스".
// 약속은 "발견해서 본인에게 알린다"까지. 흐름 다이어그램은 UzuFlowDiagram, 대시보드 이미지는 매니페스트 슬롯 uzudebris-dashboard.
import UzuFlowDiagram from './UzuFlowDiagram.astro';
import RenewalImage from './RenewalImage.astro';
const steps = [
  { title: '영상을 등록합니다', body: '채널 주소나 원본 파일을 올리면 됩니다.' },
  {
    title: '지문으로 해킹된 영상을 추적합니다',
    body: '화면과 소리에서 원본의 지문을 뽑아, 제목을 바꾸고 앞뒤를 잘라 다시 올린 영상까지 찾아냅니다.',
  },
  {
    title: '보안 채널로 개인에게 알립니다',
    body: '발견한 위치와 플랫폼별 신고 방법을 함께 보내드립니다. 신고는 본인이 직접 합니다.',
  },
];

const cards = [
  {
    label: '지금 · 베타 준비',
    title: '베껴 올린 영상 찾기',
    body: '유출된 유료 콘텐츠, 자막을 덧입히고 잘라 붙인 재업로드까지 화면과 소리의 지문으로 원본과 대조합니다. 1인 창작자뿐 아니라 영화사·엔터사도 직접 가입해 쓰는 구독 서비스입니다.',
    next: false,
  },
  {
    label: '준비 중 · 기업·기관용',
    title: '합성 영상 살펴보기',
    body: '같은 흐름에 얼굴 합성 여부 확인을 더할 계획입니다. 본인이 등록한 얼굴만 대조하고, 결과는 단정하지 않고 합성 가능성으로 보여 드립니다.',
    next: true,
  },
];

const audiences = [
  {
    title: '이런 분들을 위해 만듭니다',
    items: [
      '유료 구독 플랫폼에서 화보·영상을 파는 창작자',
      '방송 장면이 짜깁기 숏폼으로 도는 스트리머',
      '계약이 끝난 뒤에도 사진·영상이 쓰이는 프리랜서 모델·배우',
      '소속사 없이 혼자 대응하는 마이크로 인플루언서',
    ],
  },
  {
    title: '함께 쓰는 곳',
    items: [
      '소속 창작자 수십 명을 매니저가 직접 살피는 중소형 MCN·기획사',
      '개봉작·방송 콘텐츠가 불법 재업로드로 도는 영화사·엔터테인먼트사',
      // 공개 표기 미결정(design.md 미결정 5) — F28 에서 빼기로 하면 이 줄을 통째로 지운다.
      '침해 사건을 다루면서 찾는 일은 손으로 하는 법무법인·평판관리 업체 — 우주데브리스는 찾는 도구를 공급합니다.',
    ],
  },
];
---
<section id="uzudebris" class="section section--paper" aria-labelledby="uzudebris-title">
  <div class="container section__inner">
    <header class="section__head">
      <p class="eyebrow eyebrow--on-paper">CASE 01 · 우주데브리스 — 생성 AI 악용 대응</p>
      <h2 id="uzudebris-title" class="section__title">내 영상이 어디에 올라가 있는지, 먼저 알려드립니다.</h2>
      <p class="section__lead">
        유료로 판 화보와 영상이 무료 사이트에 올라가고, 방송 장면이 짜깁기 숏폼으로 다시 돌고, 계약이 끝난 사진이 쇼핑몰에 남아 있습니다. 소속사도 법무팀도 없는 창작자는 대개 우연히 알게 됩니다. 그 '우연'을 없애는 일을 합니다.
      </p>
    </header>

    <figure class="uzu-shot" data-reveal>
      <RenewalImage slot="uzudebris-dashboard" ratio="3 / 2" />
    </figure>

    <ol class="uzu-steps" data-step-group>
      {steps.map((s, i) => (
        <li class="uzu-steps__item" data-step={i + 1}>
          <span class="uzu-steps__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="uzu-steps__title">{s.title}</h3>
          <p class="uzu-steps__body">{s.body}</p>
        </li>
      ))}
    </ol>

    <UzuFlowDiagram />

    <ul class="uzu-cards">
      {cards.map((c) => (
        <li class:list={['uzu-card', { 'uzu-card--next': c.next }]}>
          <p class="eyebrow eyebrow--on-paper">{c.label}</p>
          <h3 class="uzu-card__title">{c.title}</h3>
          <p class="uzu-card__body">{c.body}</p>
        </li>
      ))}
    </ul>

    <div class="uzu-audience">
      {audiences.map((a) => (
        <div class="uzu-audience__group">
          <h3 class="uzu-audience__title">{a.title}</h3>
          <ul class="uzu-audience__list">
            {a.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <div class="uzu-limits">
      <h3 class="uzu-limits__title">우주데브리스가 하지 않는 일</h3>
      <p class="uzu-limits__body">
        게시물을 대신 지우거나 법률 판단을 내리지 않습니다. 로그인해야 볼 수 있는 곳과 메신저 채널은 살피지 않습니다. 찾은 결과는 본인이 플랫폼 신고나 공공 지원 절차에 그대로 쓸 수 있도록 정리해 드립니다.
      </p>
    </div>

    <div class="uzu-cta">
      <a class="btn btn--signal uzu-cta__btn" href="https://uzudebris.com" rel="noopener">
        내 채널 무료 스캔 받아보기 <span aria-hidden="true">→</span>
      </a>
      <p class="uzu-cta__note">공개된 콘텐츠를 1회 스캔해 의심 링크 목록을 보내드립니다.</p>
    </div>
  </div>
</section>

<style>
  .uzu-shot {
    margin: 0;
    max-width: 960px;
  }

  .uzu-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    border-top: 1px solid var(--color-line-on-paper);
  }
  .uzu-steps__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-6) var(--space-8) 0;
  }
  .uzu-steps__num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-signal-ink);
  }
  .uzu-steps__title {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    word-break: keep-all;
  }
  .uzu-steps__body {
    margin: 0;
    max-width: 36ch;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-muted-on-paper);
    word-break: keep-all;
  }

  .uzu-cards {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }
  .uzu-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8);
    border: 1px solid var(--color-ink);
  }
  .uzu-card--next {
    border-color: var(--color-line-on-paper);
    border-style: dashed;
  }
  .uzu-card__title {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: var(--leading-tight);
    word-break: keep-all;
  }
  .uzu-card__body {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-muted-on-paper);
    word-break: keep-all;
  }

  .uzu-audience {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-12);
  }
  .uzu-audience__title,
  .uzu-limits__title {
    margin: 0 0 var(--space-4);
    font-size: var(--text-lg);
    font-weight: 500;
  }
  .uzu-audience__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .uzu-audience__list li {
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-line-on-paper);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-muted-on-paper);
    word-break: keep-all;
  }

  .uzu-limits {
    max-width: 760px;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-ink);
  }
  .uzu-limits__body {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-muted-on-paper);
    word-break: keep-all;
  }

  .uzu-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .uzu-cta__btn {
    gap: var(--space-2);
  }
  /* 밝은 바탕에서는 기본 hover(paper 바탕)가 사라지므로 ink 로 뒤집는다 */
  :global(body.site) .uzu-cta__btn:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .uzu-cta__note {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted-on-paper);
  }
</style>
