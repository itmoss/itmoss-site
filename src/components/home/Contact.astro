---
// #contact — 시그널 오렌지 바탕. 문구: docs/renewal/copy.md "## 연락".
// 이번 범위는 메일 링크와 처리방침 안내만 (구독 폼은 다음 단계).
import { CONTACT_EMAIL } from "../../config/site.js";
---
<section id="contact" class="section section--signal" aria-labelledby="contact-title">
  <div class="container section__inner">
    <header class="section__head">
      <h2 id="contact-title" class="section__title">영상이 있는 곳이면<br />같이 풀어 볼 수 있습니다.</h2>
      <p class="section__lead">
        창작자, MCN, 브랜드, 연구기관 모두 환영합니다. 하고 싶은 일을 짧게 적어 보내 주시면 답장드립니다.
      </p>
    </header>
    <div class="contact__actions">
      <a
        class="contact__mail"
        href={`mailto:${CONTACT_EMAIL}`}
        aria-label={`아이티모스에 메일 보내기 (${CONTACT_EMAIL})`}
      >
        <span class="contact__mail-addr">{CONTACT_EMAIL}</span>
        <span class="contact__mail-arrow" aria-hidden="true">→</span>
      </a>
      <p class="contact__note">
        보내 주신 메일 주소는 답장에만 씁니다. <a href="/privacy/">개인정보처리방침</a>
      </p>
    </div>
  </div>
</section>

<style>
  .contact__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }
  body.site .contact__mail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 56px;
    padding: 0 var(--space-6);
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }
  body.site .contact__mail:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }
  body.site .contact__mail:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }
  .contact__mail-arrow {
    transition: transform 160ms ease;
  }
  .contact__mail:hover .contact__mail-arrow {
    transform: translateX(4px);
  }
  .contact__note {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--color-ink);
    word-break: keep-all;
  }
  body.site .contact__note a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .contact__mail-arrow { transition: none; }
    .contact__mail:hover .contact__mail-arrow { transform: none; }
  }
</style>
