---
// 히어로 3D 지구본 (장식, aria-hidden). 점 지구가 자전하고 궤도 파편 중 하나만 signal 로 "발견".
// 지구 곳곳에 실사 영상 썸네일(.clip, 스프라이트 globe-clips.webp)을 JS 가 빼곡히 겹친다 — 점 하나하나가 "영상".
// 그리기는 src/scripts/heroglobe.js (cobe, 번들). 상자는 고정 비율이라 CLS 없음.
// JS·WebGL 이 없으면 같은 상자에 정적 SVG 가 그대로 남는다.
---
<div class="globe" data-globe-box aria-hidden="true">
  <svg class="globe__fallback" viewBox="0 0 100 100" focusable="false">
    <circle class="globe__sphere" cx="50" cy="50" r="34" />
    <ellipse class="globe__line" cx="50" cy="50" rx="34" ry="12" />
    <ellipse class="globe__line" cx="50" cy="50" rx="14" ry="34" />
    <ellipse class="globe__orbit" cx="50" cy="50" rx="46" ry="16" transform="rotate(-18 50 50)" />
    <circle class="globe__debris" cx="9" cy="62" r="1.2" />
    <circle class="globe__debris" cx="30" cy="31" r="1.2" />
    <circle class="globe__debris" cx="88" cy="30" r="1.2" />
    <circle class="globe__debris" cx="70" cy="66" r="1.2" />
    <circle class="globe__found" cx="91" cy="37" r="2.4" />
  </svg>
  <canvas class="globe__canvas" data-globe aria-hidden="true"></canvas>
  <div class="globe__clips" data-globe-clips></div>
</div>

<script src="../../scripts/heroglobe.js"></script>

<style>
  .globe {
    position: relative;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    color: var(--color-paper);
    container-type: inline-size;
  }
  .globe__canvas,
  .globe__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .globe__canvas {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .globe.is-live .globe__canvas {
    opacity: 1;
  }
  .globe.is-live .globe__fallback {
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  /* 점마다 겹치는 실사 영상 썸네일. 위치·크기·깊이는 heroglobe.js 가 transform·변수로만 바꾼다. */
  .globe__clips {
    position: absolute;
    inset: 0;
    overflow-x: clip; /* 가장자리 썸네일이 390px 화면에서 가로 스크롤을 만들지 않게 */
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s ease 0.3s;
  }
  .globe.is-live .globe__clips {
    opacity: 1;
  }
  .globe__clips :global(.clip) {
    position: absolute;
    left: 0;
    top: 0;
    width: 9cqi;
    aspect-ratio: 16 / 10;
    border: 1px solid color-mix(in srgb, var(--color-paper) 22%, transparent);
    border-radius: 2px;
    background: var(--color-ink);
    overflow: hidden;
    opacity: var(--depth, 1);
    will-change: transform;
    transition: opacity 0.4s ease;
  }
  .globe__clips :global(.clip.is-back) {
    opacity: 0;
  }
  /* 스프라이트 칸은 정사각 — 가운데를 16:10 으로 잘라 보인다 */
  .globe__clips :global(.clip__img) {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    aspect-ratio: 1;
    translate: 0 -50%;
    background: var(--sprite) var(--x) var(--y) / 600% 400% no-repeat;
  }
  .globe__clips :global(.clip__bar) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 8%;
    min-height: 1px;
    background: color-mix(in srgb, var(--color-ink) 60%, transparent);
  }
  .globe__clips :global(.clip__bar i) {
    display: block;
    height: 100%;
    background: var(--color-paper);
    transform-origin: left;
    animation: clip-play var(--dur, 6s) linear var(--delay, 0s) infinite;
  }
  .globe.is-paused :global(.clip__bar i) {
    animation-play-state: paused;
  }

  /* 발견된 영상: 크게, signal 테두리 + 검출 모서리 + 타임코드 */
  .globe__clips :global(.clip--found) {
    width: 15cqi;
    border: 1.5px solid var(--color-signal);
    overflow: visible;
    opacity: 1;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-signal) 18%, transparent);
  }
  .globe__clips :global(.clip--found .clip__img) {
    clip-path: inset(18.75% 0);
  }
  .globe__clips :global(.clip--found .clip__bar i) {
    background: var(--color-signal);
  }
  .globe__clips :global(.clip__tc) {
    position: absolute;
    left: -1.5px;
    bottom: calc(100% + 4px);
    padding: 2px 5px;
    background: var(--color-signal);
    color: var(--color-ink);
    font: 600 max(9px, 1.9cqi) / 1 var(--font-mono);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @keyframes clip-play {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .globe__sphere {
    fill: none;
    stroke: var(--color-faint);
    stroke-width: 0.4;
    stroke-dasharray: 0.6 1.4;
  }
  .globe__line {
    fill: none;
    stroke: var(--color-line);
    stroke-width: 0.3;
  }
  .globe__orbit {
    fill: none;
    stroke: var(--color-line);
    stroke-width: 0.3;
    stroke-dasharray: 1 1.5;
  }
  .globe__debris {
    fill: var(--color-muted);
  }
  .globe__found {
    fill: var(--color-signal);
  }

  @media (prefers-reduced-motion: reduce) {
    .globe__canvas,
    .globe.is-live .globe__fallback,
    .globe__clips {
      transition: none;
    }
    .globe__clips :global(.clip__bar i) {
      animation: none;
      transform: scaleX(0.4);
    }
  }
</style>
