---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact — ITMOSS">

  <section class="gradient-hero min-h-[80vh] flex flex-col items-center justify-center px-6 text-center py-20">
    <div class="max-w-lg mx-auto">
      <p class="section-label reveal">CONTACT</p>
      <h1 class="text-6xl md:text-7xl font-black tracking-tight mt-2 mb-4 reveal">
        연락하기
      </h1>
      <p class="text-slate-500 mb-14 reveal reveal-delay-1">
        협업 제안, 프로젝트 문의 — 무엇이든 환영합니다.
      </p>

      <div class="space-y-4 w-full reveal reveal-delay-2">
        <a
          href="mailto:jaster@itmoss.com"
          class="card flex items-center gap-5 text-left hover:no-underline group p-6"
        >
          <div class="icon-box icon-box-indigo w-12 h-12 shrink-0">
            <i class="fa-solid fa-envelope"></i>
          </div>
          <div>
            <p class="text-xs font-bold text-indigo-600 uppercase tracking-widest mb-1">Email</p>
            <p class="text-lg font-black group-hover:text-indigo-600 transition-colors">jaster@itmoss.com</p>
          </div>
          <i class="fa-solid fa-arrow-right ml-auto text-slate-300 group-hover:text-indigo-500 group-hover:translate-x-1 transition-all"></i>
        </a>

        <a
          href="https://blog.naver.com/itmoss"
          target="_blank"
          rel="noopener noreferrer"
          class="card flex items-center gap-5 text-left hover:no-underline group p-6"
        >
          <div class="icon-box icon-box-green w-12 h-12 shrink-0">
            <i class="fa-solid fa-blog"></i>
          </div>
          <div>
            <p class="text-xs font-bold text-green-600 uppercase tracking-widest mb-1">Blog</p>
            <p class="text-lg font-black group-hover:text-indigo-600 transition-colors">blog.naver.com/itmoss</p>
          </div>
          <i class="fa-solid fa-arrow-right ml-auto text-slate-300 group-hover:text-indigo-500 group-hover:translate-x-1 transition-all"></i>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
