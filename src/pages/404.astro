---
// /404.html — GitHub Pages 가 없는 주소에서 기본 404 대신 이 페이지를 보여 준다. 문구: docs/renewal/copy.md "## 404".
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="페이지를 찾을 수 없습니다 — 아이티모스"
  description="요청하신 페이지를 찾을 수 없습니다."
>
  <section class="notfound">
    <p class="eyebrow">404</p>
    <h1 class="notfound__title">찾으시는 페이지가 없습니다.</h1>
    <p class="notfound__body">주소가 바뀌었거나 사라진 페이지입니다. 홈에서 다시 찾아 주세요.</p>
    <div class="notfound__actions">
      <a class="notfound__btn" href="/">홈으로 가기</a>
      <a class="notfound__link" href="/#contact">문의하기</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-20) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    word-break: keep-all;
  }
  .notfound__title {
    margin: 0;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    font-weight: 700;
  }
  .notfound__body {
    margin: 0;
    line-height: var(--leading-body);
    color: var(--color-muted);
  }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-4);
  }
  /* 버튼 모양은 홈(index.astro)의 .btn--signal 과 같게 — 그 규칙은 홈 페이지에만 실린다 */
  .notfound__btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-6);
    background: var(--color-signal);
    color: var(--color-ink);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 160ms ease;
  }
  .notfound__btn:hover {
    background: var(--color-paper);
  }
  .notfound__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
