---
import BaseLayout from "../layouts/BaseLayout.astro";
const projects = [
  {
    title: "RabbitScene PhotoBooth",
    blurb: "윈도우 키오스크 · WebRTC 프리뷰 · 실시간 필터",
    tags: ["Go", "C++", "WebRTC", "Canon EOS"],
    href: "/notes/rabbitscene-intro"
  },
  {
    title: "K-Beauty Vector Search",
    blurb: "CLIP/SigLIP 멀티모달 검색 · Supabase · pgvector",
    tags: ["Python", "Supabase", "Astro"],
    href: "/notes/kbeauty-vector-search"
  },
  {
    title: "Trading Infra (Toobit)",
    blurb: "Go 기반 멀티봇 · WS 실시간 · Redis/Valkey",
    tags: ["Go", "WebSocket", "Redis"],
    href: "/notes/trading-infra"
  }
];
---
<BaseLayout>
  <section class="py-24 md:py-32">
    <div class="grid md:grid-cols-2 gap-10 items-center">
      <div class="space-y-6">
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight">
          Experiments in <span class="text-[var(--accent)]">AI · Video · Commerce</span>
        </h1>
        <p class="text-lg text-[var(--muted)]">
          솔로 창업자(개인사업자)로 운영하는 실험실. 빠르게 만들고, 측정하고, 공개합니다.
        </p>
        <div class="flex gap-3">
          <a class="btn btn-accent" href="#projects">프로젝트 보기</a>
          <a class="btn" href="/contact">협업 문의</a>
        </div>
      </div>
      <div class="card">
        <ul class="prose prose-invert">
          <li>Astro + MDX 정적 사이트</li>
          <li>Cloudflare Pages로 즉시 배포</li>
          <li>Notes로 기술 기록(한/영/일 확장 가능)</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="projects" class="py-10 space-y-6">
    <h2 class="text-2xl font-bold">Projects</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      {projects.map((p) => (
        <a href={p.href} class="card">
          <h3 class="font-semibold">{p.title}</h3>
          <p class="text-sm text-[var(--muted)]">{p.blurb}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {p.tags.map(t => <span class="text-xs px-2 py-1 ring-1 ring-white/10 rounded-full">{t}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
