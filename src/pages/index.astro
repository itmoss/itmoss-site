---
// 홈 — 섹션 조립만 한다 (design.md "컴포넌트 파일"). 문구는 docs/renewal/copy.md.
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import Engines from "../components/home/Engines.astro";
import CaseUzudebris from "../components/home/CaseUzudebris.astro";
import News from "../components/home/News.astro";
import Timeline from "../components/home/Timeline.astro";
import About from "../components/home/About.astro";
import Contact from "../components/home/Contact.astro";
import "../styles/home.css";
---
<BaseLayout
  title="아이티모스 — 영상 해킹에 맞서는 단 하나의 AI 솔루션, 우주데브리스"
  description="아이티모스는 영상과 보안을 20년간 다뤄 온 팀이 만든 영상 해킹 AI 회사입니다. 해킹된 영상을 찾아 알려 주는 우주데브리스, 카메라로 화장품 성분을 읽는 해픽을 만듭니다."
>
  <Hero />
  <Engines />
  <CaseUzudebris />
  <section id="record" class="section section--ruled" aria-labelledby="record-title">
    <div class="container section__inner">
      <News />
      <Timeline />
    </div>
  </section>
  <About />
  <Contact />
</BaseLayout>
