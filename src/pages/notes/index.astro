---
import BaseLayout from "../../layouts/BaseLayout.astro";
const noteModules = import.meta.glob('./*.mdx');
const entries = Object.keys(noteModules).map((path) => path.replace('./', '').replace('.mdx', ''));
---
<BaseLayout
  title="아이티모스 기술 노트 — ITMOSS Notes"
  description="아이티모스(ITMOSS)의 기술 노트. Vision AI, 벡터 검색, 트레이딩 인프라 등 딥테크 주제를 다룹니다.">
  <section class="notes">
    <div class="notes__head">
      <div class="notes__label">> NOTES</div>
      <h1 class="notes__title">[NOTES]</h1>
      <p class="notes__lead">> 기술, 아이디어, 그리고 관측의 기록들.</p>
    </div>
    <ul class="notes__list">
      {entries.map((name) => (
        <li>
          <a href={`/notes/${name}`} class="notes__item">
            <span class="notes__tag">[NOTE]</span>
            <span class="notes__name">{name}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  /* 다크 바탕 토큰만 — 예전 밝은 테마 변수(--muted·--accent)와 .card(흰 바탕)는 대비가 맞지 않는다. */
  .notes {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-16) var(--gutter);
    font-family: var(--font-mono);
  }
  .notes__head { margin-bottom: var(--space-12); }
  .notes__label,
  .notes__lead {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .notes__title {
    margin: var(--space-4) 0 0;
    font-size: var(--text-3xl);
    letter-spacing: 0.08em;
  }
  .notes__lead { margin-top: var(--space-6); }
  .notes__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .notes__list li { border-bottom: 1px solid var(--color-line); }
  body.site .notes__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-height: var(--tap-min);
    padding: var(--space-5) 0;
    text-decoration: none;
  }
  .notes__tag {
    font-size: var(--text-xs);
    color: var(--color-signal);
    letter-spacing: 0.08em;
  }
  .notes__name { font-weight: 500; }
</style>
