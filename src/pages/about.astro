        <p class="section-label">TEAM</p>
        <T 
          tag="h2" 
          class="text-2xl sm:text-3xl font-black mt-2" 
          en="The People Behind It" 
          ko="만드는 사람들" 
          vi="Những Người Phía Sau" 
          th="ผู้ที่อยู่เบื้องหลัง" 
