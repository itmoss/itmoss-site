---
import BaseLayout from "../layouts/BaseLayout.astro";
import T from "../components/i18n/T.astro";

const principles = [
  {
    num: "01",
    badge: "Civilizational Bootstrap",
    badgeKo: "문명의 부트스트랩",
    badgeVi: "Bootstrap Văn minh",
    badgeTh: "การเริ่มต้นอารยธรรม",
    badgeBn: "সভ্যতার বুটস্ট্র্যাপ",
    badgeJa: "文明のブートストラップ",
    badgeZh: "文明引导程序",
    title: "The Soil of the Digital Wilderness",
    titleKo: "디지털 황무지의 토양",
    titleVi: "Mảnh đất của Hoang mạc Kỹ thuật số",
    titleTh: "ผืนดินแห่งถิ่นทุรกันดารทางดิจิทัล",
    titleBn: "ডিজিটাল মরুভূমির মাটি",
    titleJa: "デジタル荒野の土壌",
    titleZh: "数字荒野的土壤",
    body: "ITMOSS does not seek to be the protagonist. It is the foundational infrastructure that lays itself down first — turning the chaotic digital wilderness into stable ground where humans (observers) can stand comfortably.",
    bodyKo: "itmoss는 거창한 주인공이 되려 하지 않는다. 황무지 같은 디지털 세상에 가장 먼저 깔려서, 인간이 편안하게 서 있을 수 있는 '디지털 토양'을 만드는 기초 인프라다.",
    bodyVi: "ITMOSS không tìm cách trở thành nhân vật chính. Đây là cơ sở hạ tầng nền tảng tự đặt ra trước — biến vùng hoang dã kỹ thuật số hỗn loạn thành vùng đất ổn định nơi con người có thể đứng thoải mái.",
    bodyTh: "ITMOSS ไม่ได้พยายามเป็นตัวเอก แต่เป็นโครงสร้างพื้นฐานแรกที่ถูกวางลง เปลี่ยนป่าดิจิทัลอันวุ่นวายให้เป็นดินแดนที่มั่นคง",
    bodyBn: "ITMOSS নায়ক হতে চায় না। এটি একটি প্রাথমিক অবকাঠামো যা ডিজিটাল মরুভূমিকে স্থিতিশীল করে।",
    bodyJa: "ITMOSSは主役になろうとはしません。混沌としたデジタル世界を安定した土台に変える、最も初期の基礎インフラです。",
    bodyZh: "ITMOSS 不求做主角。它是最早铺设的基础设施——将混乱的数字荒野变成稳定的基石。",
    icon: "fa-solid fa-seedling",
    color: "icon-box-green",
    img: "/images/Gemini_Generated_Image_cm7tyacm7tyacm7t.png",
    imgAlt: "Civilizational Bootstrap — moss growing over circuits",
    imgRight: true,
  },
  {
    num: "02",
    badge: "The Invisible Safety Net",
    badgeKo: "보이지 않는 안전망",
    badgeVi: "Mạng lưới An toàn Vô hình",
    badgeTh: "ตาข่ายนิรภัยที่มองไม่เห็น",
    badgeBn: "অদৃশ্য নিরাপত্তা জাল",
    badgeJa: "見えない安全網",
    badgeZh: "无形的安全网",
    title: "A Bottom-up Presence",
    titleKo: "Bottom-up 존재",
    titleVi: "Hiện diện Từ Dưới Lên",
    titleTh: "การแสดงตนจากล่างขึ้นบน",
    titleBn: "নিচ থেকে উপস্থিতি",
    titleJa: "ボトムアップの存在",
    titleZh: "自下而上的存在",
    body: "Rather than AI looking down on humans (top-down), ITMOSS supports from beneath — gently, from the ground up. It becomes the shock-absorbing layer that protects observers from being hurt by technological complexity.",
    bodyKo: "AI가 인간을 내려다보는 구조가 아니라, 인간의 발밑에서 가장 부드럽게 받쳐주는 Bottom-up 존재. 관측자가 기술적 복잡함에 다치지 않도록 보호하는 충격 흡수층이 된다.",
    bodyVi: "Thay vì AI nhìn xuống con người, ITMOSS hỗ trợ từ dưới lên — trở thành lớp giảm xóc bảo vệ mắt khỏi sự phức tạp công nghệ.",
    bodyTh: "เราสนับสนุนจากด้านล่างอย่างอ่อนโยน เป็นชั้นดูดซับแรงกระแทกจากความซับซ้อนทางเทคโนโลยี",
    bodyBn: "আমরা প্রযুক্তিগত জটিলতা থেকে রক্ষা করি।",
    bodyJa: "AIが人間を見下ろすのではなく、足元から優しく支えるボトムアップの存在です。",
    bodyZh: "与其让人工智能俯视人类，ITMOSS 选择从底部提供支持——成为保护观察者免受技术复杂性伤害的缓冲层。",
    icon: "fa-solid fa-shield-halved",
    color: "icon-box-indigo",
    img: "/images/Gemini_Generated_Image_vs7laxvs7laxvs7l.png",
    imgAlt: "The Invisible Safety Net — moss cushioning human steps",
    imgRight: false,
  },
  {
    num: "03",
    badge: "Data Filtering & Optimization",
    badgeKo: "데이터 필터링 & 최적화",
    badgeVi: "Lọc & Tối ưu Dữ liệu",
    badgeTh: "การกรองและเพิ่มประสิทธิภาพข้อมูล",
    badgeBn: "ডেটা ফিল্টারিং এবং অপ্টিমাইজেশন",
    badgeJa: "データフィルタリングと最適化",
    badgeZh: "数据过滤与优化",
    title: "Filtering Out the Noise",
    titleKo: "노이즈를 걸러내다",
    titleVi: "Lọc Bỏ Tiếng Ồn",
    titleTh: "กรองเสียงรบกวน",
    titleBn: "নয়েজ ফিল্টার করা",
    titleJa: "ノイズをフィルタリングする",
    titleZh: "滤除噪音",
    body: "Rather than letting the world's flood of information flow through unfiltered, ITMOSS absorbs and retains it. Noise and contaminants are filtered out, delivering only the clearest, most refined version of reality to humans.",
    bodyKo: "쏟아지는 정보를 그대로 흘려보내지 않고 itmoss가 머금는다. 노이즈를 걸러내어, 인간에게는 가장 맑고 정제된 상태의 '현실'만을 제공한다.",
    bodyVi: "Thay vì để luồng thông tin thế giới chảy qua không kiểm soát, ITMOSS hấp thụ nó, cung cấp phiên bản thực tế tinh chế nhất.",
    bodyTh: "ITMOSS จะดูดซับและกรองเสียงรบกวน เพื่อส่งมอบความจริงที่ชัดเจนและประณีตที่สุด",
    bodyBn: "আমরা সবচেয়ে পরিষ্কার বাস্তবতা প্রদান করি।",
    bodyJa: "あふれる情報からノイズを取り除き、人間に最も純粋な現実だけを提供します。",
    bodyZh: "ITMOSS 不让世界泛滥的信息未经处理流过，而是过滤掉噪音和杂质，只呈现最纯净的真相。",
    icon: "fa-solid fa-filter",
    color: "icon-box-amber",
    img: "/images/Gemini_Generated_Image_e1wnqde1wnqde1wn.png",
    imgAlt: "Data Filtering — moss as a natural filter",
    imgRight: true,
  },
  {
    num: "04",
    badge: "Boundary-free Network",
    badgeKo: "무경계의 네트워크",
    badgeVi: "Mạng lưới Không Rào Cản",
    badgeTh: "เครือข่ายไร้พรมแดน",
    badgeBn: "সীমানাহীন নেটওয়ার্ক",
    badgeJa: "境界のないネットワーク",
    badgeZh: "无边界的网络",
    title: "We Refuse Lock-in",
    titleKo: "Lock-in을 거부한다",
    titleVi: "Chúng tôi Từ Chối Ràng Buộc",
    titleTh: "เราขอปฏิเสธการผูกขาด",
    titleBn: "আমরা লক-ইন প্রত্যাখ্যান করি",
    titleJa: "ロックインを拒否します",
    titleZh: "我们拒绝锁定",
    body: "Where Big Tech giants drive deep roots and trap users in their ecosystems, ITMOSS spreads thin and wide across the surface — providing every connection and piece of information users need without burden or dependency.",
    bodyKo: "거대 플랫폼들이 사용자를 Lock-in하려 했다면, itmoss는 표면에 얇고 넓게 퍼져 사용자에게 부담을 주지 않으면서 필요한 모든 연결을 제공한다.",
    bodyVi: "ITMOSS lan tỏa rộng khắp trên bề mặt — cung cấp mọi kết nối cần thiết mà không gây gánh nặng.",
    bodyTh: "เรากระจายตัวกว้างขวางเพื่อเชื่อมต่อข้อมูลโดยไม่สร้างภาระหรือความพึ่งพิง",
    bodyBn: "আমরা প্রয়োজনীয় সংযোগ প্রদান করি নির্ভরশীলতা ছাড়াই।",
    bodyJa: "ユーザーをエコシステムに閉じ込める巨大企業とは対照的に、ITMOSSは依存させずにすべての必要な接続を提供します。",
    bodyZh: "大企业将用户困在自己的生态系统中，而 ITMOSS 则平铺广泛——提供所需的连接而不造成负担。",
    icon: "fa-solid fa-arrows-to-circle",
    color: "icon-box-pink",
    img: "/images/Gemini_Generated_Image_i0lhoei0lhoei0lh.png",
    imgAlt: "Boundary-free Network — moss connecting the globe",
    imgRight: false,
  },
  {
    num: "05",
    badge: "Resilience",
    badgeKo: "끈질긴 생명력",
    badgeVi: "Kiên cường",
    badgeTh: "ความยืดหยุ่น",
    badgeBn: "স্থিতিস্থাপকতা",
    badgeJa: "粘り強い生命力",
    badgeZh: "韧性",
    title: "Quietly, Like Moss",
    titleKo: "이끼처럼 조용히",
    titleVi: "Lặng lẽ Như Rêu",
    titleTh: "เงียบงันเหมือนมอส",
    titleBn: "মরুভূমির ঘাসের মত শান্ত",
    titleJa: "苔のように静かに",
    titleZh: "静静地，像苔藓",
    body: "True vitality is the power to quietly take root in even the most barren environment — until one's presence becomes indispensable. Like moss, seeping into the spaces closest to human life and coexisting in silence.",
    bodyKo: "어떤 척박한 환경에서도 조용히 뿌리내려 없어서는 안 될 존재감을 드러내는 힘. 이끼처럼, 인간의 삶 가장 가까운 곳에 스며들어 조용히 '공존'하는 것.",
    bodyVi: "Sức sống thực sự là lặng lẽ bám rễ ở bất cứ môi trường khắc nghiệt nào. Giống như rêu sống chung yên lặng bên cạnh con người.",
    bodyTh: "พลังที่แท้จริงคือความสามารถในการหยั่งรากเงียบๆ แม้ในสภาพแวดล้อมที่แห้งแล้งที่สุด... เช่นเดียวกับมอสที่อยู่ร่วมด้วยความสงบ",
    bodyBn: "আমরা মানুষের কাছাকাছি শান্তভাবে সহাবস্থান করি।",
    bodyJa: "どんな過酷な環境でも静かに根を張る力。苔のように、人間の生活のすぐそばで静かに共存します。",
    bodyZh: "真正的生命力是在荒凉环境中静静扎根的力量...像苔藓一样，渗入离人类生活最近的空间中平静共存。",
    icon: "fa-solid fa-leaf",
    color: "icon-box-green",
    img: "/images/Gemini_Generated_Image_97x3vo97x3vo97x3.png",
    imgAlt: "Resilience — moss breaking through rock",
    imgRight: true,
  },
];
---
<BaseLayout title="About — ITMOSS">

  <!-- ══════════════════════════════════════════
       HEADER
  ══════════════════════════════════════════ -->
  <section class="gradient-hero py-20 sm:py-28 text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <p class="section-label">ABOUT</p>
      <h1 class="text-5xl sm:text-6xl md:text-8xl font-black tracking-tight mt-2 mb-4 sm:mb-6">ITMOSS</h1>
      <T 
        tag="p" 
        class="text-base sm:text-lg text-slate-500 leading-relaxed" 
        en="From the lowest ground, closest to you." 
        ko="가장 낮은 곳에서, 당신과 가장 가깝게." 
        vi="Từ nơi thấp nhất, gần bạn nhất." 
        th="จากที่ที่ต่ำที่สุด ใกล้ตัวคุณที่สุด" 
        bn="সবচেয়ে নিচু জায়গা থেকে, আপনার সবচেয়ে কাছাকাছি।" 
        ja="最も低い場所から、あなたに最も近く。" 
        zh="从最低处，离你最近。" 
      />
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       PHILOSOPHY
  ══════════════════════════════════════════ -->
  <section class="py-16 sm:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <div class="reveal">
        <p class="section-label">PHILOSOPHY</p>
        <T 
          tag="p" 
          class="text-3xl sm:text-4xl md:text-5xl font-black leading-tight mt-2 mb-4 sm:mb-6" 
          en={`"Without your gaze,<br /><span class="gradient-text">there is no technology."</span>`} 
          ko={`"당신의 시선이 없다면,<br /><span class="gradient-text">기술도 없습니다."</span>`} 
          vi={`"Không có ánh nhìn của bạn,<br /><span class="gradient-text">không có công nghệ."</span>`} 
          th={`"หากปราศจากสายตาของคุณ<br /><span class="gradient-text">ก็จะไม่มีเทคโนโลยี"</span>`} 
          bn={`"আপনার দৃষ্টি ছাড়া,<br /><span class="gradient-text">কোনো প্রযুক্তি নেই।"</span>`} 
          ja={`"あなたの視線がなければ、<br /><span class="gradient-text">技術もありません。"</span>`} 
          zh={`"没有你的注视，<br /><span class="gradient-text">就没有技术。"</span>`} 
        />
        <T 
          tag="p" 
          class="text-slate-500 leading-relaxed text-sm sm:text-base mt-4" 
          en={`Technology truly exists only when it meets your gaze.<br />Humans are the protagonist of the stage, Technology is the invisible assistant.`} 
          ko={`기술은 당신의 시선이 닿을 때 비로소 실재합니다. <br />인간은 무대의 주인공, 기술은 보이지 않는 조력자입니다.`} 
          vi={`Công nghệ chỉ thực sự tồn tại khi có ánh nhìn của bạn.<br />Con người là nhân vật chính của sân khấu, Công nghệ là người trợ lý vô hình.`} 
          th={`เทคโนโลยีจะดำรงอยู่ได้ก็ต่อเมื่อมีสายตาของคุณ<br />มนุษย์คือตัวเอกของเวที เทคโนโลยีคือผู้ช่วยที่มองไม่เห็น`} 
          bn={`প্রযুক্তি কেবল তখনই অস্তিত্ব লাভ করে যখন এটি আপনার দৃষ্টি আকর্ষণ করে।<br />মানুষ হলো মঞ্চের নায়ক, প্রযুক্তি হলো অদৃশ্য সহায়ক।`} 
          ja={`技術はあなたの視線に触れて初めて実在します。<br />人間は舞台の主人公、技術は見えない協力者です。`} 
          zh={`技术只有在你的注视下才真正存在。<br />人类是舞台的主角，技术是无形的助手。`} 
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 text-left mt-10 sm:mt-12">
        <div class="reveal reveal-delay-1 card p-5 sm:p-8">
          <div class="icon-box icon-box-indigo">
            <i class="fa-solid fa-eye"></i>
          </div>
          <span class="badge badge-indigo mb-2">HUMAN</span>
          <p class="text-base sm:text-lg font-black mt-2 mb-1">Observer</p>
          <T 
            tag="p" 
            class="text-sm text-slate-500" 
            en="The protagonist of a new era." 
            ko="새로운 시대의 주체." 
            vi="Chủ thể của một kỷ nguyên mới." 
            th="ตัวเอกของยุคใหม่" 
            bn="নতুন যুগের নায়ক।" 
            ja="新しい時代の主体。" 
            zh="新时代的主体。" 
          />
        </div>
        <div class="reveal reveal-delay-2 card p-5 sm:p-8">
          <div class="icon-box icon-box-pink">
            <i class="fa-solid fa-microchip"></i>
          </div>
          <span class="badge badge-pink mb-2">TECH</span>
          <p class="text-base sm:text-lg font-black mt-2 mb-1">Stage Manager</p>
          <T 
            tag="p" 
            class="text-sm text-slate-500" 
            en="Technology exists only for the audience." 
            ko="기술은 오직 관객을 위해만 존재합니다." 
            vi="Công nghệ chỉ tồn tại vì khán giả." 
            th="เทคโนโลยีมีอยู่เพื่อผู้ชมเท่านั้น" 
            bn="প্রযুক্তি কেবল দর্শকদের জন্যই বিদ্যমান।" 
            ja="技術はただ観客のためだけに存在します。" 
            zh="技术只为观众而存在。" 
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       THE PROTOCOL — 5 Principles of Coexistence
  ══════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12 sm:mb-20 reveal">
        <p class="section-label">THE PROTOCOL</p>
        <T 
            tag="h2" 
            class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mt-2 mb-3 sm:mb-4" 
            en="5 Principles of Coexistence" 
            ko="공존의 5원칙" 
            vi="5 Nguyên tắc Đồng Tồn tại" 
            th="หลัก 5 ประการแห่งการอยู่ร่วมกัน" 
            bn="সহাবস্থানের ৫টি নীতি" 
            ja="共存のための5原則" 
            zh="5 条共存原则" 
        />
        <T 
            tag="p" 
            class="text-slate-500 max-w-lg mx-auto text-sm sm:text-base mt-2" 
            en="A world free from unnecessary constraints, where you can fully immerse yourself in experiencing and enjoying." 
            ko="불필요한 제약에서 벗어나, 온전히 경험하고 즐기는 것에 몰입할 수 있는 세상." 
            vi="Một thế giới thoát khỏi những ràng buộc không cần thiết, nơi bạn có thể hoàn toàn đắm chìm vào trải nghiệm và tận hưởng." 
            th="โลกที่ปราศจากข้อจำกัดที่ไม่จำเป็น ที่ซึ่งคุณสามารถดื่มด่ำกับประสบการณ์และความเพลิดเพลินได้อย่างเต็มที่" 
            bn="অপ্রয়োজনীয় সীমাবদ্ধতা থেকে মুক্ত একটি বিশ্ব, যেখানে আপনি সম্পূর্ণরূপে অভিজ্ঞতা এবং উপভোগ করতে মগ্ন হতে পারেন।" 
            ja="不要な制約から解放され、純粋に経験と楽しみに没頭できる世界。" 
            zh="一个摆脱不必要束缚的世界，在这里你可以完全沉浸于体验与享受之中。" 
        />
      </div>

      {principles.map((p, i) => (
        <div class={`py-12 sm:py-20 ${i > 0 ? 'border-t border-slate-200' : ''}`}>
          <div class={`grid md:grid-cols-2 gap-8 sm:gap-12 items-center ${!p.imgRight ? 'md:[&>*:first-child]:order-2 md:[&>*:last-child]:order-1' : ''}`}>
            <!-- Text -->
            <div class="reveal">
              <div class="flex items-center gap-3 mb-4">
                <span class="text-4xl sm:text-5xl font-black text-slate-100">{p.num}</span>
                <div class={`icon-box ${p.color} w-10 h-10`}>
                  <i class={`${p.icon} text-sm`}></i>
                </div>
              </div>
              <span class="badge badge-indigo mb-3">
                <T en={p.badge} ko={p.badgeKo} vi={p.badgeVi} th={p.badgeTh} bn={p.badgeBn} ja={p.badgeJa} zh={p.badgeZh} />
              </span>
              <T tag="h3" class="text-xl sm:text-2xl font-black mt-3 mb-3" en={p.title} ko={p.titleKo} vi={p.titleVi} th={p.titleTh} bn={p.titleBn} ja={p.titleJa} zh={p.titleZh} />
              <T tag="p" class="text-slate-500 leading-relaxed text-sm mt-2" en={p.body} ko={p.bodyKo} vi={p.bodyVi} th={p.bodyTh} bn={p.bodyBn} ja={p.bodyJa} zh={p.bodyZh} />
            </div>

            <!-- Image -->
            <div class="reveal reveal-delay-1">
              <img
                src={p.img}
                alt={p.imgAlt}
                class="w-full rounded-2xl object-contain bg-white p-3 sm:p-4 shadow-sm hover:shadow-md transition-shadow duration-300"
              />
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       TEAM
  ══════════════════════════════════════════ -->
  <section class="py-16 sm:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10 sm:mb-12 reveal">
        <p class="section-label">TEAM</p>
        <T 
          tag="h2" 
          class="text-2xl sm:text-3xl font-black mt-2" 
          en="The People Behind It" 
          ko="만드는 사람들" 
          vi="Những Người Phía Sau" 
          th="ผู้ที่อยู่เบื้องหลัง" 
          bn="পিছনের মানুষেরা" 
          ja="作り手たち" 
          zh="背后的推手" 
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <div class="reveal reveal-delay-1 card text-center p-6 sm:p-8">
          <span class="badge badge-indigo mb-4">FOUNDER</span>
          <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-slate-100 overflow-hidden mx-auto mb-4">
            <img
              src="/images/logo-itmoss.png"
              alt="Jaster"
              class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500"
            />
          </div>
          <p class="text-base sm:text-lg font-black">Jaster</p>
          <p class="text-sm text-slate-500 mt-1">Founder / Designer</p>
        </div>

        <div class="reveal reveal-delay-2 card text-center p-6 sm:p-8">
          <span class="badge badge-pink mb-4">AI COLLABORATOR</span>
          <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-slate-50 border-2 border-indigo-100 overflow-hidden mx-auto mb-4 flex items-center justify-center">
            <i class="fa-solid fa-robot text-xl sm:text-2xl text-indigo-400"></i>
          </div>
          <p class="text-base sm:text-lg font-black">Wilson</p>
          <p class="text-sm text-slate-500 mt-1">AI Collaborator</p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
