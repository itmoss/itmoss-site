---
import '../styles/global.css';
const {
  title = "ITMOSS — No Observer, No Reality.",
  description = "가장 낮은 곳에서, 가장 넓게 퍼져, 황무지 같은 데이터 세상을 인간이 살기 좋은 정원으로 바꾸는 기술.",
} = Astro.props;
---
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;800&display=swap" rel="stylesheet">
  </head>
  <body class="font-body antialiased">
    <header class="max-w-7xl mx-auto px-6 py-8 flex items-center justify-between border-b-2 border-[var(--fg)]">
      <a href="/" class="flex items-center gap-3 group">
        <span class="text-3xl font-black font-mono">[</span>
        <svg width="40" height="40" viewBox="0 0 48 48" class="transition-transform group-hover:scale-110">
          <rect x="8" y="24" width="32" height="16" rx="2" fill="none" stroke="var(--fg)" stroke-width="2"/>
          <rect x="10" y="26" width="28" height="12" rx="1" fill="var(--bg)"/>
          <rect x="12" y="10" width="24" height="16" rx="1" fill="none" stroke="var(--fg)" stroke-width="2"/>
          <rect x="13" y="11" width="22" height="14" fill="#88ff88"/>
          <path d="M 14 26 Q 10 20, 12 14 Q 14 18, 16 22" fill="#88ff88" opacity="0.8"/>
          <path d="M 32 26 Q 36 18, 34 12 Q 32 16, 30 22" fill="#88ff88" opacity="0.8"/>
          <circle cx="20" cy="20" r="3" fill="#88ff88" opacity="0.6"/>
        </svg>
        <span class="text-2xl font-black tracking-tight font-mono">ITMOSS</span>
        <span class="text-3xl font-black font-mono">]</span>
      </a>
      <nav class="flex gap-6 text-xs font-bold uppercase tracking-widest font-mono">
        <a href="/#the-structure" class="hover:text-[var(--accent)] transition-colors hidden md:block">[STRUCTURE]</a>
        <a href="/#the-protocol" class="hover:text-[var(--accent)] transition-colors hidden md:block">[PROTOCOL]</a>
        <a href="/notes" class="hover:text-[var(--accent)] transition-colors">[NOTES]</a>
        <a href="/about" class="hover:text-[var(--accent)] transition-colors">[ABOUT]</a>
        <a href="/contact" class="hover:text-[var(--accent)] transition-colors">[CONTACT]</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="max-w-7xl mx-auto px-6 py-12 border-t-2 border-[var(--fg)] font-mono">
      <div class="flex flex-col md:flex-row justify-between items-start gap-4 text-xs text-[var(--muted)]">
        <div class="space-y-1">
          <p>> © {new Date().getFullYear()} ITMOSS</p>
          <p>> Designed by Jaster, Managed by AI.</p>
        </div>
        <div class="space-y-1 text-right">
          <p>"No Observer, No Reality."</p>
          <p>BUILT WITH ASTRO | READY...</p>
        </div>
      </div>
    </footer>
  </body>
</html>
