---
import '../styles/global.css';
const {
  title = "ITMOSS — Engineering the Visual Future.",
  description = "ITMOSS builds deep-tech infrastructure for precision beauty analysis and digital portrait rights, powered by Vision AI and blockchain convergence technology.",
} = Astro.props;

const currentPath = Astro.url.pathname;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://itmoss.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/images/image.png" type="image/png" />
    <title>{title}</title>

    <!-- Google Fonts: Inter + Noto Sans KR -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+KR:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <!-- Font Awesome 6 -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      crossorigin="anonymous"
    />
  </head>
  <body class="font-sans antialiased bg-white text-slate-900">

    <!-- ── NAV ── -->
    <header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group">
          <img src="/images/logo-itmoss.png" alt="ITMOSS" class="h-8 w-8 object-contain transition-transform group-hover:scale-110" />
          <span class="text-base font-black tracking-tight text-slate-900">ITMOSS</span>
        </a>
        <nav class="hidden md:flex items-center gap-6">
          <a href="https://blog.naver.com/itmoss" target="_blank" rel="noopener noreferrer" class="nav-link">Notes</a>
          <a href="/about" class={`nav-link ${currentPath === '/about' ? 'active' : ''}`}>About</a>
          <a href="/contact" class="btn btn-primary text-xs px-4 py-2">
            <i class="fa-regular fa-envelope text-xs"></i>Contact
          </a>
        </nav>
        <button id="mobile-menu-btn" class="md:hidden p-2 text-slate-600 hover:text-indigo-600 transition-colors" aria-label="Open menu">
          <i class="fa-solid fa-bars text-lg"></i>
        </button>
      </div>
      <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-slate-100 px-4 py-3 space-y-1 shadow-lg">
        <a href="https://blog.naver.com/itmoss" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-indigo-50 hover:text-indigo-600">
          <i class="fa-regular fa-newspaper w-4 text-center"></i>Notes
        </a>
        <a href="/about" class="flex items-center gap-2 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-indigo-50 hover:text-indigo-600">
          <i class="fa-regular fa-circle-user w-4 text-center"></i>About
        </a>
        <a href="/contact" class="flex items-center gap-2 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:bg-indigo-50 hover:text-indigo-600">
          <i class="fa-regular fa-envelope w-4 text-center"></i>Contact
        </a>
      </div>
    </header>

    <main class="pt-[72px]">
      <slot />
    </main>

    <!-- ── FOOTER ── -->
    <footer class="bg-slate-900 text-white mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
        <div class="flex flex-col md:flex-row justify-between items-start gap-10">
          <div class="max-w-xs">
            <div class="flex items-center gap-2 mb-4">
              <img src="/images/logo-itmoss.png" alt="ITMOSS" class="h-7 w-7 object-contain brightness-[10] opacity-80" />
              <span class="text-base font-black tracking-tight text-white">ITMOSS</span>
            </div>
            <p class="text-slate-400 text-sm leading-relaxed">
              Deep-tech infrastructure for Vision AI<br />
              and blockchain convergence.
            </p>
            <p class="text-slate-600 text-xs italic mt-2">"Engineering the Visual Future."</p>
          </div>
          <div class="grid grid-cols-2 gap-8 sm:gap-12 text-sm">
            <div>
              <p class="font-semibold mb-3 text-white">Navigate</p>
              <ul class="space-y-2 text-slate-400">
                <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
                <li><a href="https://blog.naver.com/itmoss" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Notes</a></li>
                <li><a href="/about" class="hover:text-white transition-colors">About</a></li>
              </ul>
            </div>
            <div>
              <p class="font-semibold mb-3 text-white">Contact</p>
              <ul class="space-y-2 text-slate-400">
                <li>
                  <a href="mailto:jaster@itmoss.com" class="hover:text-white transition-colors break-all">
                    <i class="fa-solid fa-envelope mr-1.5 text-xs"></i>jaster@itmoss.com
                  </a>
                </li>
                <li>
                  <a href="https://blog.naver.com/itmoss" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                    <i class="fa-solid fa-blog mr-1.5 text-xs"></i>Naver Blog
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
        <div class="border-t border-slate-800 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-slate-500">
          <span>© {new Date().getFullYear()} itmoss Inc. All rights reserved.</span>
          <span class="italic">"Engineering the Visual Future."</span>
        </div>
      </div>
    </footer>

    <script>
      // Scroll reveal
      const observer = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('visible'); }),
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // Sticky nav
      const header = document.getElementById('site-header');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
          header?.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-slate-100');
        } else {
          header?.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-slate-100');
        }
      });

      // Mobile menu
      document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
        document.getElementById('mobile-menu')?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
