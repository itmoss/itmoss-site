---
import '../styles/global.css';
import '../styles/tokens.css';
import '../styles/scroll.css';

// .mdx 의 layout 으로 쓰일 때는 frontmatter 가 Astro.props.frontmatter 로 들어온다.
const props = { ...(Astro.props.frontmatter ?? {}), ...Astro.props };
const {
  title = "아이티모스 ITMOSS — 영상을 만드는 기술로 영상을 지키는 비전 AI",
  description = "아이티모스(ITMOSS)는 영상을 만드는 기술로 영상을 지키는 비전 AI 회사입니다. 창작자 영상 무단 재송출 탐지 우주데브리스와 뷰티 비전 AI 해픽을 만듭니다.",
  image = "/images/brand/apple-touch-icon.png",
  type = "website",
  publishDate,
  keywords = "아이티모스, ITMOSS, 비전 AI, Vision AI, 우주데브리스, 해픽, 영상 지문, 무단 재송출 탐지, 뷰티 AI",
} = props;
// 화면 문구는 한국어가 기본. 다국어는 다음 단계.
const lang = 'ko';

const siteURL = 'https://itmoss.com';
const canonicalURL = new URL(Astro.url.pathname, siteURL).href;
const ogImage = image.startsWith('http') ? image : new URL(image, siteURL).href;
const logoURL = `${siteURL}/images/brand/logo-on-light.webp`;
const isArticle = type === 'article';
const isHome = Astro.url.pathname === '/';
// 홈에서는 같은 페이지 앵커, 다른 페이지에서는 홈의 앵커로 보낸다.
const anchor = (id: string) => (isHome ? `#${id}` : `/#${id}`);
const GA_ID = 'G-FZK5GDSNNR';
const CONTACT_EMAIL = 'jaster@itmoss.com';

const csp = [
  "default-src 'self'",
  "script-src 'self' https://www.googletagmanager.com",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src https://fonts.gstatic.com",
  "img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com",
  "connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com",
  "form-action 'self'",
  "frame-src 'none'",
  "base-uri 'self'",
  "object-src 'none'",
].join('; ');

const nav = [
  { id: 'uzudebris', label: '우주데브리스' },
  { id: 'haepick', label: '해픽 · Vision AI' },
  { id: 'record', label: '소식' },
  { id: 'about', label: '회사' },
  { id: 'contact', label: '연락' },
];
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="ITMOSS" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/images/brand/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/images/brand/apple-touch-icon.png" sizes="180x180" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content="ITMOSS" />
    {publishDate && <meta property="article:published_time" content={publishDate} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD (데이터 블록 — 실행되지 않으므로 CSP 대상 아님) -->
    {isArticle ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": title,
        "description": description,
        "image": ogImage,
        "url": canonicalURL,
        "datePublished": publishDate,
        "author": { "@type": "Organization", "name": "ITMOSS" },
        "publisher": {
          "@type": "Organization",
          "name": "ITMOSS",
          "logo": { "@type": "ImageObject", "url": logoURL }
        }
      })} />
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "ITMOSS",
        "alternateName": "아이티모스",
        "url": siteURL,
        "logo": logoURL,
        "description": "아이티모스(ITMOSS) — 영상을 만드는 기술로 영상을 지키는 비전 AI 회사",
        "email": CONTACT_EMAIL,
        "sameAs": []
      })} />
    )}

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google Fonts: IBM Plex Sans KR + IBM Plex Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@300;400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics GA4 (초기화는 /scripts/gtag-init.js — 인라인 스크립트 없음) -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} is:inline></script>
    <script src="/scripts/gtag-init.js" is:inline></script>
  </head>
  <body class="site">
    <a class="skip-link" href="#main">본문 바로가기</a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-logo" href={isHome ? '#top' : '/'} aria-label="아이티모스 홈">
          <img src="/images/brand/logo-on-dark.webp" width="724" height="150" alt="아이티모스 itmoss" />
        </a>
        <nav class="site-nav" aria-label="주 메뉴">
          {nav.map((item) => <a href={anchor(item.id)}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main" class={isArticle ? 'site-main site-article' : 'site-main'}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <a class="site-logo site-logo--footer" href="/" aria-label="아이티모스 홈">
          <img src="/images/brand/logo-on-dark.webp" width="724" height="150" alt="아이티모스 itmoss" loading="lazy" />
        </a>
        <ul class="site-footer__links">
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          <li><a href="/privacy/">개인정보처리방침</a></li>
        </ul>
        <p class="site-footer__meta">
          <span>아이티모스</span>
          <span>© {new Date().getFullYear()} ITMOSS</span>
        </p>
      </div>
    </footer>

    <!-- 스크롤 연출 (번들 모듈 — 인라인 아님) -->
    <script src="../scripts/scrollfx.js"></script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: var(--header-h);
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
  html, body.site {
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
  body.site {
    margin: 0;
    line-height: var(--leading-body);
  }
  body.site a {
    color: inherit;
  }
  body.site a:hover {
    color: var(--color-signal);
  }
  body.site :focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 3px;
  }

  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: calc(-1 * var(--space-16));
    z-index: 100;
    padding: var(--space-3) var(--space-4);
    background: var(--color-signal);
    color: var(--color-ink);
    font-weight: 500;
    text-decoration: none;
  }
  .skip-link:focus {
    top: var(--space-4);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }
  .site-header__inner,
  .site-footer__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding-inline: var(--gutter);
    box-sizing: border-box;
  }
  .site-header__inner {
    min-height: var(--header-h);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-6);
  }
  .site-logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
  .site-logo img {
    display: block;
    height: var(--logo-h);
    width: auto;
  }
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-7);
    font-size: var(--text-base);
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    text-decoration: none;
  }
  @media (max-width: 640px) {
    .site-nav {
      column-gap: var(--space-4);
      font-size: var(--text-sm);
    }
  }

  .site-main {
    display: block;
  }
  .site-article {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-16) var(--gutter);
  }
  .site-article h1 {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-8);
  }
  .site-article h2 {
    font-size: var(--text-xl);
    margin: var(--space-12) 0 var(--space-4);
  }
  .site-article ul {
    list-style: disc;
    padding-left: var(--space-6);
  }

  .site-footer {
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .site-footer__inner {
    padding-block: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
  }
  .site-logo--footer img {
    height: var(--space-7);
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
  }
  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
  }
</style>
